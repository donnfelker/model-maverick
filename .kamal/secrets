# Kamal 2 secrets for config/deploy.yml and config/deploy-proxy.yml (bead 9.4).
#
# This file holds NO values. Each line reads its value from the environment of the shell
# that runs kamal (for example, exported from a password manager just before the deploy).
# An unset variable gives an empty value. Never write a real value into this file.
#
# MAVERICK_DATABASE_URL points at the postgres accessory, for example
#   postgres://maverick:<POSTGRES_PASSWORD>@maverick-postgres:5432/maverick

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

POSTGRES_PASSWORD=$POSTGRES_PASSWORD
MAVERICK_DATABASE_URL=$MAVERICK_DATABASE_URL
MAVERICK_INTERNAL_TOKENS=$MAVERICK_INTERNAL_TOKENS
MAVERICK_CAPTURE_MASTER_KEY=$MAVERICK_CAPTURE_MASTER_KEY
MAVERICK_CAPTURE_PREVIOUS_MASTER_KEY=$MAVERICK_CAPTURE_PREVIOUS_MASTER_KEY

MAVERICK_ANTHROPIC_API_KEY=$MAVERICK_ANTHROPIC_API_KEY
MAVERICK_OPENAI_API_KEY=$MAVERICK_OPENAI_API_KEY
MAVERICK_GOOGLE_API_KEY=$MAVERICK_GOOGLE_API_KEY
MAVERICK_XAI_API_KEY=$MAVERICK_XAI_API_KEY

MAVERICK_SMTP_URL=$MAVERICK_SMTP_URL
MAVERICK_ALERTS_WEBHOOK_SECRET=$MAVERICK_ALERTS_WEBHOOK_SECRET

MAVERICK_BACKUP_TARGET=$MAVERICK_BACKUP_TARGET
RCLONE_CONFIG_OFFSITE_TYPE=$RCLONE_CONFIG_OFFSITE_TYPE
RCLONE_CONFIG_OFFSITE_PROVIDER=$RCLONE_CONFIG_OFFSITE_PROVIDER
RCLONE_CONFIG_OFFSITE_ENDPOINT=$RCLONE_CONFIG_OFFSITE_ENDPOINT
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=$RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=$RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY
