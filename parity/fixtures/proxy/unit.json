{
  "area": "proxy",
  "source": "Literal outputs from calling the Go internal/proxy pure functions in a scratch copy. Rows whose name starts with EXTRA have no Go test; they record observed Go behavior and are parity targets.",
  "notes": {
    "parse_alias": "error values: not_maverick_alias | malformed_alias. Both surface as the identical HTTP 400 invalid_model_alias. mode is the ENGINE mode (auto -> balanced). pool empty string means no pool field is sent.",
    "extract_last_user_text": "ok=false means the caller sends the declared fallback workload {capability: multi_step_reasoning, difficulty: 3}. text is only meaningful when ok=true.",
    "bearer_token": "input is the first Authorization header value (Header.Get); output \"\" means no client credential.",
    "rewrite_model": "normalizer: none | chat (reasoning_effort) | messages (output_config.effort). output_body is byte-exact. error=true means the attempt is skipped silently (not counted as an attempt).",
    "build_upstream_headers": "base header set before the per-attempt credential header and (messages surface) anthropic-version default are applied. Header names canonical MIME form.",
    "load_config": "config shows the parsed Config struct field values; error is the exact error string.",
    "parse_usage": "null means field omitted from the telemetry item. Non-integer numbers make the whole parse fail (both null)."
  },
