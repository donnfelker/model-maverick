  "grade_probes": [
    {
      "spec": "{\"rules\":[{\"max_length_chars\":3}]}",
      "output": "héé",
      "dimensions": {
        "constraint_compliance": 1
      },
      "detail_exact_bytes": "{\"rules\":[{\"index\":0,\"kind\":\"max_length_chars\",\"pass\":true,\"weight\":1}],\"score\":1,\"critical_failed\":false}"
    },
    {
      "spec": "{\"rules\":[{\"max_length_chars\":3}]}",
      "output": "héé!",
      "dimensions": {
        "constraint_compliance": 0
      },
      "detail_exact_bytes": "{\"rules\":[{\"index\":0,\"kind\":\"max_length_chars\",\"pass\":false,\"weight\":1}],\"score\":0,\"critical_failed\":false}"
    },
    {
