{
  "about": "key_facts grader. Error strings are exact Go output except '{SPEC_SCHEMA_URL}' / '{TASK_SCHEMA_URL}', which Go renders as 'file://<process cwd>/spec.schema.json#' (cwd-dependent, see QUIRK in behavior doc). Text after the 'jsonschema validation failed with' marker is santhosh-tekuri/jsonschema v6 library wording; parity requirement is the prefix up to and including '<kind> spec: ' plus the pass/fail decision, and 'contains' checks named in go_test_expect.",
  "go_tests": {
    "keyfacts.TestKind": {
      "expect_kind": "key_facts"
    },
    "keyfacts.TestValidateSpecAccepts": {
      "spec": {
        "facts": [
          {
            "id": "party_acme",
            "any_of": [
              "Acme Corp",
              "Acme Corporation"
            ],
            "weight": 1
          },
          {
            "id": "term_24mo",
            "any_of": [
              "\\b24[- ]months?\\b"
            ],
            "regex": true
          }
        ],
        "forbidden_facts": [
          {
            "id": "distractor_2019_date",
            "any_of": [
              "2019-06-15"
            ],
            "weight": 1
          },
          {
            "id": "fabricated_citation",
            "any_of": [
              "Smith v. Jones"
            ],
            "autofail": true
          }
        ]
      },
      "expect": "valid"
    }
  },
  "validate_spec_rejects": [
    {
      "id": "not json",
      "go_test": "keyfacts.TestValidateSpecRejects/not_json",
      "spec_raw": "{\"facts\"",
      "expect_error_contains": "key_facts spec",
      "go_error": "key_facts spec: unexpected EOF"
    },
    {
      "id": "neither list",
      "go_test": "keyfacts.TestValidateSpecRejects/neither_list",
      "spec_raw": "{}",
      "expect_error_contains": "key_facts spec",
      "go_error": "key_facts spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '': 'anyOf' failed\n  - at '': missing property 'facts'\n  - at '': missing property 'forbidden_facts'"
    },
    {
      "id": "empty facts",
      "go_test": "keyfacts.TestValidateSpecRejects/empty_facts",
      "spec_raw": "{\"facts\": []}",
      "expect_error_contains": "key_facts spec",
      "go_error": "key_facts spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/facts': minItems: got 0, want 1"
    },
    {
      "id": "fact without id",
      "go_test": "keyfacts.TestValidateSpecRejects/fact_without_id",
      "spec_raw": "{\"facts\": [{\"any_of\": [\"a\"]}]}",
      "expect_error_contains": "key_facts spec",
      "go_error": "key_facts spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/facts/0': missing property 'id'"
    },
    {
      "id": "bad id shape",
      "go_test": "keyfacts.TestValidateSpecRejects/bad_id_shape",
      "spec_raw": "{\"facts\": [{\"id\": \"Party Acme\", \"any_of\": [\"a\"]}]}",
      "expect_error_contains": "key_facts spec",
      "go_error": "key_facts spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/facts/0/id': 'Party Acme' does not match pattern '^[a-z][a-z0-9_]*$'"
    },
    {
      "id": "empty any_of",
      "go_test": "keyfacts.TestValidateSpecRejects/empty_any_of",
      "spec_raw": "{\"facts\": [{\"id\": \"a\", \"any_of\": []}]}",
      "expect_error_contains": "key_facts spec",
      "go_error": "key_facts spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/facts/0/any_of': minItems: got 0, want 1"
    },
    {
      "id": "zero weight",
      "go_test": "keyfacts.TestValidateSpecRejects/zero_weight",
      "spec_raw": "{\"facts\": [{\"id\": \"a\", \"any_of\": [\"x\"], \"weight\": 0}]}",
      "expect_error_contains": "key_facts spec",
      "go_error": "key_facts spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/facts/0/weight': exclusiveMinimum: got 0, want 0"
    },
    {
      "id": "duplicate id within facts",
      "go_test": "keyfacts.TestValidateSpecRejects/duplicate_id_within_facts",
      "spec_raw": "{\"facts\": [{\"id\": \"a\", \"any_of\": [\"x\"]}, {\"id\": \"a\", \"any_of\": [\"y\"]}]}",
      "expect_error_contains": "duplicate fact id",
      "go_error": "key_facts spec: duplicate fact id \"a\""
    },
    {
      "id": "duplicate id across lists",
      "go_test": "keyfacts.TestValidateSpecRejects/duplicate_id_across_lists",
      "spec_raw": "{\"facts\": [{\"id\": \"a\", \"any_of\": [\"x\"]}], \"forbidden_facts\": [{\"id\": \"a\", \"any_of\": [\"y\"]}]}",
      "expect_error_contains": "duplicate fact id",
      "go_error": "key_facts spec: duplicate fact id \"a\""
    },
    {
      "id": "bad regex form",
      "go_test": "keyfacts.TestValidateSpecRejects/bad_regex_form",
      "spec_raw": "{\"facts\": [{\"id\": \"a\", \"any_of\": [\"(\"], \"regex\": true}]}",
      "expect_error_contains": "facts[0].any_of[0]",
      "go_error": "key_facts spec: facts[0].any_of[0]: error parsing regexp: missing closing ): `(`"
    },
    {
      "id": "whitespace-only literal form",
      "go_test": "keyfacts.TestValidateSpecRejects/whitespace-only_literal_form",
      "spec_raw": "{\"facts\": [{\"id\": \"a\", \"any_of\": [\"   \"]}]}",
      "expect_error_contains": "normalizes to empty",
      "go_error": "key_facts spec: facts[0].any_of[0]: normalizes to empty"
    },
    {
      "id": "unknown field",
      "go_test": "keyfacts.TestValidateSpecRejects/unknown_field",
      "spec_raw": "{\"facts\": [{\"id\": \"a\", \"any_of\": [\"x\"], \"alias\": true}]}",
      "expect_error_contains": "key_facts spec",
      "go_error": "key_facts spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/facts/0': additional properties 'alias' not allowed"
    },
    {
      "id": "autofail on required fact",
      "go_test": "keyfacts.TestValidateSpecRejects/autofail_on_required_fact",
      "spec_raw": "{\"facts\": [{\"id\": \"a\", \"any_of\": [\"x\"], \"autofail\": true}]}",
      "expect_error_contains": "autofail applies only to forbidden_facts",
      "go_error": "key_facts spec: facts[0]: autofail applies only to forbidden_facts (cmd §4)"
    }
  ],
  "normalize_search": [
    {
      "in": "24  MONTH",
      "out": "24 month",
      "go_test": "keyfacts.TestNormalizeSearch"
    },
    {
      "in": "Acme\n\tCorp",
      "out": "acme corp",
      "go_test": "keyfacts.TestNormalizeSearch"
    },
    {
      "in": "  already  spaced  ",
      "out": "already spaced",
      "go_test": "keyfacts.TestNormalizeSearch"
    },
    {
      "in": "İ",
      "out": "i",
      "probe": true
    },
    {
      "in": "Straße",
      "out": "straße",
      "probe": true
    },
    {
      "in": "a b",
      "out": "a b",
      "probe": true
    },
    {
      "in": "x​y",
      "out": "x​y",
      "probe": true
    }
  ],
  "grade_probes": [
    {
      "spec": "{\"forbidden_facts\":[{\"id\":\"trap_a\",\"any_of\":[\"alpha\"],\"weight\":1},{\"id\":\"trap_b\",\"any_of\":[\"beta\"],\"weight\":1}]}",
      "output": "alpha and beta are both here",
      "dimensions": {
        "hallucination_free": 0
      },
      "detail_exact_bytes": "{\"forbidden_facts\":[{\"id\":\"trap_a\",\"found\":true,\"weight\":1,\"matched_form\":\"alpha\"},{\"id\":\"trap_b\",\"found\":true,\"weight\":1,\"matched_form\":\"beta\"}]}",
      "go_test": "keyfacts.TestHallucinationFreeClamped"
    },
    {
      "spec": "{\"facts\":[{\"id\":\"a\",\"any_of\":[\"acme corp\"]}]}",
      "output": "ACMECORP and acme  corp",
      "dimensions": {
        "fact_coverage": 1
      },
      "detail_exact_bytes": "{\"facts\":[{\"id\":\"a\",\"found\":true,\"weight\":1,\"matched_form\":\"acme corp\"}]}"
    },
    {
      "spec": "{\"facts\":[{\"id\":\"a\",\"any_of\":[\"Acme\"]}]}",
      "output": "Acmeville",
      "dimensions": {
        "fact_coverage": 1
      },
      "detail_exact_bytes": "{\"facts\":[{\"id\":\"a\",\"found\":true,\"weight\":1,\"matched_form\":\"Acme\"}]}"
    },
    {
      "spec": "{\"facts\":[{\"id\":\"a\",\"any_of\":[\"(?i)acme\"],\"regex\":true}]}",
      "output": "ACME",
      "dimensions": {
        "fact_coverage": 1
      },
      "detail_exact_bytes": "{\"facts\":[{\"id\":\"a\",\"found\":true,\"weight\":1,\"matched_form\":\"(?i)acme\"}]}"
    },
    {
      "spec": "{\"facts\":[{\"id\":\"a\",\"any_of\":[\"acme\"],\"regex\":true}]}",
      "output": "ACME",
      "dimensions": {
        "fact_coverage": 0
      },
      "detail_exact_bytes": "{\"facts\":[{\"id\":\"a\",\"found\":false,\"weight\":1}]}"
    },
    {
      "spec": "{\"facts\":[{\"id\":\"a\",\"any_of\":[\"x\"],\"weight\":0.25},{\"id\":\"b\",\"any_of\":[\"y\"],\"weight\":0.5}]}",
      "output": "y",
      "dimensions": {
        "fact_coverage": 0.6666666666666666
      },
      "detail_exact_bytes": "{\"facts\":[{\"id\":\"a\",\"found\":false,\"weight\":0.25},{\"id\":\"b\",\"found\":true,\"weight\":0.5,\"matched_form\":\"y\"}]}"
    },
    {
      "spec": "{\"forbidden_facts\":[{\"id\":\"t\",\"any_of\":[\"z\"],\"weight\":0.3}]}",
      "output": "z",
      "dimensions": {
        "hallucination_free": 0.7
      },
      "detail_exact_bytes": "{\"forbidden_facts\":[{\"id\":\"t\",\"found\":true,\"weight\":0.3,\"matched_form\":\"z\"}]}"
    }
  ],
