  "extract_last_user_text": [
    {
      "body": "{\"messages\":[{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"user\",\"content\":\"first question\"},{\"role\":\"assistant\",\"content\":\"answer\"},{\"role\":\"user\",\"content\":\"second question, the real one\"}]}",
      "name": "string content, last user message wins",
      "ok": true,
      "text": "second question, the real one",
      "id": "extract_last_user_text-0"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"part A \"},{\"type\":\"image_url\",\"image_url\":{\"url\":\"http://example.com/x.png\"}},{\"type\":\"text\",\"text\":\"part B\"}]}]}",
      "name": "array content, concatenates text parts only",
      "ok": true,
      "text": "part A part B",
      "id": "extract_last_user_text-1"
    },
    {
      "body": "{\"messages\":[{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"assistant\",\"content\":\"hi\"}]}",
      "name": "no user message at all",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-2"
    },
    {
      "body": "{\"model\":\"maverick/auto\"}",
      "name": "no messages field",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-3"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"image_url\",\"image_url\":{\"url\":\"http://example.com/x.png\"}}]}]}",
      "name": "last user message has only non-text parts",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-4"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":\"\"}]}",
      "name": "last user message content is empty string",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-5"
    },
    {
      "body": "not json",
      "name": "malformed JSON",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-6"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":\"earlier\"},{\"role\":\"user\",\"content\":\"\"}]}",
      "name": "EXTRA last user empty does not fall back to earlier user",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-7"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":\"q\"},{\"role\":\"assistant\",\"content\":\"a\"}]}",
      "name": "EXTRA trailing assistant after user",
      "ok": true,
      "text": "q",
      "id": "extract_last_user_text-8"
    },
    {
      "body": "{\"messages\":[{\"role\":\"User\",\"content\":\"q\"}]}",
      "name": "EXTRA role match is case-sensitive",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-9"
    },
    {
      "body": "{\"Messages\":[{\"ROLE\":\"user\",\"Content\":[{\"TYPE\":\"text\",\"Text\":\"k\"}]}]}",
      "name": "EXTRA JSON keys match case-insensitively",
      "ok": true,
      "text": "k",
      "id": "extract_last_user_text-10"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":null}]}",
      "name": "EXTRA null content",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-11"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":42}]}",
      "name": "EXTRA numeric content",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-12"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"Text\",\"text\":\"x\"},{\"type\":\"input_text\",\"text\":\"y\"},{\"type\":\"text\",\"text\":\"z\"}]}]}",
      "name": "EXTRA type field exact 'text' only",
      "ok": true,
      "text": "z",
      "id": "extract_last_user_text-13"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":\"ok\"},{\"role\":5}]}",
      "name": "EXTRA one malformed message element voids the whole parse",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-14"
    },
    {
      "body": "{\"messages\":\"hi\"}",
      "name": "EXTRA messages not an array",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-15"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":\"   \"}]}",
      "name": "EXTRA whitespace-only text is kept",
      "ok": true,
      "text": "   ",
      "id": "extract_last_user_text-16"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":1}]}]}",
      "name": "EXTRA part with non-string text voids array",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-17"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"t\",\"content\":\"r\"}]}]}",
      "name": "EXTRA tool_result blocks ignored (anthropic)",
      "ok": false,
      "text": "",
      "id": "extract_last_user_text-18"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":\"a�b\"}]}",
      "name": "EXTRA invalid UTF-8 replaced by U+FFFD",
      "ok": true,
      "text": "a�b",
      "id": "extract_last_user_text-19"
    },
    {
      "body": "{\"messages\":[{\"role\":\"user\",\"content\":\"\\u00e9\\ud83d\\ude00\"}]}",
      "name": "EXTRA escaped unicode decoded",
      "ok": true,
      "text": "é😀",
      "id": "extract_last_user_text-20"
    },
    {
      "body_generator": "content = 'a' repeated 101000 times",
      "name": "TestExtractLastUserText_Caps: 101000 x 'a' capped",
      "ok": true,
      "text_generator": "'a' repeated 100000 times",
      "text_rune_count": 100000,
      "id": "extract_last_user_text-21"
    },
    {
      "body_generator": "content = U+00E9 repeated 100005 times",
      "name": "EXTRA cap counts Unicode scalar values (runes), not bytes",
      "ok": true,
      "text_byte_count": 200000,
      "text_rune_count": 100000,
      "id": "extract_last_user_text-22"
    }
  ],
