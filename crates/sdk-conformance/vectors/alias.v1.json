        "pool": null,
        "mode": "cost",
        "settings": "apply"
      }
    },
    {
      "id": "go-3",
      "model": "maverick/prod-pool:auto",
      "expect": {
        "kind": "alias",
        "pool": "prod-pool",
        "mode": "balanced",
        "settings": "apply"
      }
    },
    {
