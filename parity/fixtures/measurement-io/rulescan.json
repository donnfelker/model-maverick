{
  "about": "rule_scan grader. Error strings are exact Go output except '{SPEC_SCHEMA_URL}' / '{TASK_SCHEMA_URL}', which Go renders as 'file://<process cwd>/spec.schema.json#' (cwd-dependent, see QUIRK in behavior doc). Text after the 'jsonschema validation failed with' marker is santhosh-tekuri/jsonschema v6 library wording; parity requirement is the prefix up to and including '<kind> spec: ' plus the pass/fail decision, and 'contains' checks named in go_test_expect.",
  "go_tests": {
    "rulescan.TestKind": {
      "expect_kind": "rule_scan"
    },
    "rulescan.TestValidateSpecAccepts": {
      "spec": {
        "rules": [
          {
            "must_include": "\\bWHERE\\b",
            "regex": true,
            "weight": 2,
            "critical": false
          },
          {
            "must_not_include": "as an ai",
            "case_insensitive": true
          },
          {
            "max_length_chars": 500
          },
          {
            "max_length_words": 80
          },
          {
            "line_count": {
              "min": 1,
              "max": 10
            }
          },
          {
            "language": "fr"
          }
        ]
      },
      "expect": "valid"
    }
  },
  "validate_spec_rejects": [
    {
      "id": "not json",
      "go_test": "rulescan.TestValidateSpecRejects/not_json",
      "spec_raw": "[",
      "expect_error_contains": "rule_scan spec",
      "go_error": "rule_scan spec: unexpected EOF"
    },
    {
      "id": "missing rules",
      "go_test": "rulescan.TestValidateSpecRejects/missing_rules",
      "spec_raw": "{}",
      "expect_error_contains": "rule_scan spec",
      "go_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '': missing property 'rules'"
    },
    {
      "id": "empty rules",
      "go_test": "rulescan.TestValidateSpecRejects/empty_rules",
      "spec_raw": "{\"rules\": []}",
      "expect_error_contains": "rule_scan spec",
      "go_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/rules': minItems: got 0, want 1"
    },
    {
      "id": "rule without kind",
      "go_test": "rulescan.TestValidateSpecRejects/rule_without_kind",
      "spec_raw": "{\"rules\": [{\"weight\": 1}]}",
      "expect_error_contains": "rule_scan spec",
      "go_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/rules/0': 'oneOf' failed, none matched\n  - at '/rules/0': missing property 'must_include'\n  - at '/rules/0': missing property 'must_not_include'\n  - at '/rules/0': missing property 'max_length_chars'\n  - at '/rules/0': missing property 'max_length_words'\n  - at '/rules/0': missing property 'line_count'\n  - at '/rules/0': missing property 'language'"
    },
    {
      "id": "two kinds in one rule",
      "go_test": "rulescan.TestValidateSpecRejects/two_kinds_in_one_rule",
      "spec_raw": "{\"rules\": [{\"must_include\": \"a\", \"max_length_chars\": 10}]}",
      "expect_error_contains": "rule_scan spec",
      "go_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/rules/0': 'oneOf' failed, subschemas 0, 2 matched"
    },
    {
      "id": "regex flag on length rule",
      "go_test": "rulescan.TestValidateSpecRejects/regex_flag_on_length_rule",
      "spec_raw": "{\"rules\": [{\"max_length_chars\": 10, \"regex\": true}]}",
      "expect_error_contains": "rule_scan spec",
      "go_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/rules/0': 'anyOf' failed\n  - at '/rules/0': missing property 'must_include'\n  - at '/rules/0': missing property 'must_not_include'"
    },
    {
      "id": "bad regex",
      "go_test": "rulescan.TestValidateSpecRejects/bad_regex",
      "spec_raw": "{\"rules\": [{\"must_include\": \"(\", \"regex\": true}]}",
      "expect_error_contains": "rules[0]",
      "go_error": "rule_scan spec: rules[0]: error parsing regexp: missing closing ): `(`"
    },
    {
      "id": "zero weight",
      "go_test": "rulescan.TestValidateSpecRejects/zero_weight",
      "spec_raw": "{\"rules\": [{\"must_include\": \"a\", \"weight\": 0}]}",
      "expect_error_contains": "rule_scan spec",
      "go_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/rules/0/weight': exclusiveMinimum: got 0, want 0"
    },
    {
      "id": "unknown language",
      "go_test": "rulescan.TestValidateSpecRejects/unknown_language",
      "spec_raw": "{\"rules\": [{\"language\": \"tlh\"}]}",
      "expect_error_contains": "rule_scan spec",
      "go_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/rules/0/language': value must be one of 'en', 'es', 'fr', 'de', 'it', 'pt', 'nl', 'ru', 'zh', 'ja', 'ko', 'ar', 'he', 'el', 'hi', 'th'"
    },
    {
      "id": "empty line_count bounds",
      "go_test": "rulescan.TestValidateSpecRejects/empty_line_count_bounds",
      "spec_raw": "{\"rules\": [{\"line_count\": {}}]}",
      "expect_error_contains": "rule_scan spec",
      "go_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/rules/0/line_count': 'oneOf' failed, none matched\n  - at '/rules/0/line_count': got object, want integer\n  - at '/rules/0/line_count': minProperties: got 0, want 1"
    },
    {
      "id": "inverted line_count bounds",
      "go_test": "rulescan.TestValidateSpecRejects/inverted_line_count_bounds",
      "spec_raw": "{\"rules\": [{\"line_count\": {\"min\": 5, \"max\": 2}}]}",
      "expect_error_contains": "min 5 > max 2",
      "go_error": "rule_scan spec: rules[0]: line_count: min 5 > max 2"
    },
    {
      "id": "unknown rule field",
      "go_test": "rulescan.TestValidateSpecRejects/unknown_rule_field",
      "spec_raw": "{\"rules\": [{\"must_include\": \"a\", \"severity\": \"high\"}]}",
      "expect_error_contains": "rule_scan spec",
      "go_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/rules/0': additional properties 'severity' not allowed"
    },
    {
      "id": "case_insensitive on length (probe)",
      "go_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/rules/0': 'anyOf' failed\n  - at '/rules/0': missing property 'must_include'\n  - at '/rules/0': missing property 'must_not_include'"
    },
    {
      "id": "line_count float (probe)",
      "go_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/rules/0/line_count': 'oneOf' failed, none matched\n  - at '/rules/0/line_count': got number, want integer\n  - at '/rules/0/line_count': got number, want object"
    },
    {
      "id": "max_length_chars 1.0 (probe)",
      "go_error": "rule_scan spec: json: cannot unmarshal number 1.0 into Go struct field rule.rules.max_length_chars of type int"
    }
  ],
  "count_lines": [
    {
      "in": "",
      "out": 0,
      "go_test": "rulescan.TestCountLines"
    },
    {
      "in": "   \n\n",
      "out": 0,
      "go_test": "rulescan.TestCountLines"
    },
    {
      "in": "one line",
      "out": 1,
      "go_test": "rulescan.TestCountLines"
    },
    {
      "in": "one line\n",
      "out": 1,
      "go_test": "rulescan.TestCountLines"
    },
    {
      "in": "a\nb\nc",
      "out": 3,
      "go_test": "rulescan.TestCountLines"
    },
    {
      "in": "a\nb\nc\r\n",
      "out": 3,
      "go_test": "rulescan.TestCountLines"
    },
    {
      "in": "a\r\nb",
      "out": 2,
      "probe": true
    },
    {
      "in": "\n\na",
      "out": 3,
      "probe": true
    },
    {
      "in": "a\n\n\nb",
      "out": 4,
      "probe": true
    },
    {
      "in": "a\n \n",
      "out": 2,
      "probe": true
    },
    {
      "in": "a\rb",
      "out": 1,
      "probe": true
    },
    {
      "in": "a\n\r\n\r",
      "out": 1,
      "probe": true
    }
  ],
