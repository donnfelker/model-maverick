{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmaverick.dev/graders/key_facts/spec.schema.json",
  "title": "key_facts grader spec (version 1)",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    { "required": ["facts"] },
    { "required": ["forbidden_facts"] }
  ],
  "properties": {
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fact" }
    },
    "forbidden_facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fact" }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["id", "any_of"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "regex": { "type": "boolean" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "autofail": { "type": "boolean" }
      }
    }
  }
}
