  "fixture_results": [
    {
      "file": "bad_spec_missing_schema.yaml",
      "description": "spec payload without the required schema key is rejected at validation",
      "spec_json": {
        "checks": [
          {
            "equals": "x",
            "path": "$.name"
          }
        ]
      },
      "output": "irrelevant",
      "validate_error": "json_schema spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '': missing property 'schema'",
      "failure_counter": 0
    },
    {
      "file": "bare_object_in_prose.yaml",
      "description": "bare JSON object embedded in prose is extracted and validates",
      "spec_json": {
        "schema": {
          "properties": {
            "status": {
              "enum": [
                "ok",
                "error"
              ]
