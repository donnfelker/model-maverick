{
  "about": "golden_answer grader. Error strings are exact Go output except '{SPEC_SCHEMA_URL}' / '{TASK_SCHEMA_URL}', which Go renders as 'file://<process cwd>/spec.schema.json#' (cwd-dependent, see QUIRK in behavior doc). Text after the 'jsonschema validation failed with' marker is santhosh-tekuri/jsonschema v6 library wording; parity requirement is the prefix up to and including '<kind> spec: ' plus the pass/fail decision, and 'contains' checks named in go_test_expect.",
  "go_tests": {
    "golden.TestKind": {
      "expect_kind": "golden_answer"
    },
    "golden.TestValidateSpecAccepts": {
      "spec": {
        "answers": [
          {
            "value": "Paris"
          },
          {
            "numeric": 42,
            "tolerance": 0.5
          },
          {
            "set": [
              "a",
              "b"
            ]
          },
          {
            "regex": "(?i)yes"
          }
        ]
      },
      "expect": "valid"
    }
  },
  "validate_spec_rejects": [
    {
      "id": "not json",
      "go_test": "golden.TestValidateSpecRejects/not_json",
      "spec_raw": "{\"answers\": ",
      "expect_error_contains": "golden_answer spec",
      "go_error": "golden_answer spec: unexpected EOF"
    },
    {
      "id": "missing answers",
      "go_test": "golden.TestValidateSpecRejects/missing_answers",
      "spec_raw": "{}",
      "expect_error_contains": "golden_answer spec",
      "go_error": "golden_answer spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '': missing property 'answers'"
    },
    {
      "id": "empty answers",
      "go_test": "golden.TestValidateSpecRejects/empty_answers",
      "spec_raw": "{\"answers\": []}",
      "expect_error_contains": "golden_answer spec",
      "go_error": "golden_answer spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/answers': minItems: got 0, want 1"
    },
    {
      "id": "answer without mode",
      "go_test": "golden.TestValidateSpecRejects/answer_without_mode",
      "spec_raw": "{\"answers\": [{}]}",
      "expect_error_contains": "golden_answer spec",
      "go_error": "golden_answer spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/answers/0': 'oneOf' failed, none matched\n  - at '/answers/0': missing property 'value'\n  - at '/answers/0': missing property 'numeric'\n  - at '/answers/0': missing property 'set'\n  - at '/answers/0': missing property 'regex'"
    },
    {
      "id": "answer with two modes",
      "go_test": "golden.TestValidateSpecRejects/answer_with_two_modes",
      "spec_raw": "{\"answers\": [{\"value\": \"a\", \"numeric\": 1}]}",
      "expect_error_contains": "golden_answer spec",
      "go_error": "golden_answer spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/answers/0': 'oneOf' failed, subschemas 0, 1 matched"
    },
    {
      "id": "tolerance without numeric",
      "go_test": "golden.TestValidateSpecRejects/tolerance_without_numeric",
      "spec_raw": "{\"answers\": [{\"value\": \"a\", \"tolerance\": 0.1}]}",
      "expect_error_contains": "golden_answer spec",
      "go_error": "golden_answer spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/answers/0': properties 'numeric' required, if 'tolerance' exists"
    },
    {
      "id": "negative tolerance",
      "go_test": "golden.TestValidateSpecRejects/negative_tolerance",
      "spec_raw": "{\"answers\": [{\"numeric\": 1, \"tolerance\": -1}]}",
      "expect_error_contains": "golden_answer spec",
      "go_error": "golden_answer spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/answers/0/tolerance': minimum: got -1, want 0"
    },
    {
      "id": "empty set",
      "go_test": "golden.TestValidateSpecRejects/empty_set",
      "spec_raw": "{\"answers\": [{\"set\": []}]}",
      "expect_error_contains": "golden_answer spec",
      "go_error": "golden_answer spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/answers/0/set': minItems: got 0, want 1"
    },
    {
      "id": "value normalizes to empty",
      "go_test": "golden.TestValidateSpecRejects/value_normalizes_to_empty",
      "spec_raw": "{\"answers\": [{\"value\": \"...\"}]}",
      "expect_error_contains": "normalizes to empty",
      "go_error": "golden_answer spec: answers[0]: value normalizes to empty"
    },
    {
      "id": "bad regex",
      "go_test": "golden.TestValidateSpecRejects/bad_regex",
      "spec_raw": "{\"answers\": [{\"regex\": \"(\"}]}",
      "expect_error_contains": "answers[0]",
      "go_error": "golden_answer spec: answers[0]: error parsing regexp: missing closing ): `\\A(?:()\\z`"
    },
    {
      "id": "unknown field",
      "go_test": "golden.TestValidateSpecRejects/unknown_field",
      "spec_raw": "{\"answers\": [{\"value\": \"a\", \"mode\": \"exact\"}]}",
      "expect_error_contains": "golden_answer spec",
      "go_error": "golden_answer spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/answers/0': additional properties 'mode' not allowed"
    },
    {
      "id": "set item normalizes empty (probe)",
      "spec_raw": "{\"answers\": [{\"set\": [\"a\", \"!\"]}]}",
      "go_error": "golden_answer spec: answers[0]: set[1] normalizes to empty"
    }
  ],
  "normalize": [
    {
      "in": "  Paris.  ",
      "out": "paris",
      "go_test": "golden.TestNormalize"
    },
    {
      "in": "The\tQuick   Brown\nFox!",
      "out": "the quick brown fox",
      "go_test": "golden.TestNormalize"
    },
