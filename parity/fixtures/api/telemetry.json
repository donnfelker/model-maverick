  "envelope_422": [
    {
      "id": "env-0",
      "go_test": "api.TestTelemetryEnvelopeInvalidRequest422/empty_body",
      "body": null,
      "expected": {
        "status": 422,
        "code": "invalid_request",
        "message": "request body is required",
        "details": {}
      }
    },
    {
      "id": "env-1",
      "go_test": "api.TestTelemetryEnvelopeInvalidRequest422/malformed_json",
      "body": "{\"items\":",
      "expected": {
        "status": 422,
        "code": "invalid_request",
        "message": "malformed request body: unexpected EOF",
        "details": {}
      }
    },
    {
      "id": "env-2",
      "go_test": "api.TestTelemetryEnvelopeInvalidRequest422/non-object_body_(array)",
      "body": "[1,2,3]",
      "expected": {
        "status": 422,
        "code": "invalid_request",
        "message": "malformed request body: json: cannot unmarshal array into Go value of type handlers.telemetryEnvelope",
        "details": {}
      }
    },
    {
      "id": "env-3",
      "go_test": "api.TestTelemetryEnvelopeInvalidRequest422/non-object_body_(string)",
      "body": "\"hello\"",
      "expected": {
        "status": 422,
        "code": "invalid_request",
        "message": "malformed request body: json: cannot unmarshal string into Go value of type handlers.telemetryEnvelope",
        "details": {}
      }
    },
    {
      "id": "env-4",
      "go_test": "api.TestTelemetryEnvelopeInvalidRequest422/missing_items_key",
      "body": "{}",
      "expected": {
        "status": 422,
        "code": "invalid_request",
        "message": "items is required",
        "details": {
          "field": "items"
        }
      }
    },
    {
      "id": "env-5",
      "go_test": "api.TestTelemetryEnvelopeInvalidRequest422/null_items",
      "body": "{\"items\":null}",
      "expected": {
        "status": 422,
        "code": "invalid_request",
        "message": "items is required",
        "details": {
          "field": "items"
        }
      }
    },
    {
      "id": "env-6",
      "go_test": "api.TestTelemetryEnvelopeInvalidRequest422/non-array_items_(string)",
      "body": "{\"items\":\"nope\"}",
      "expected": {
        "status": 422,
        "code": "invalid_request",
        "message": "malformed request body: json: cannot unmarshal string into Go struct field telemetryEnvelope.items of type []json.RawMessage",
        "details": {}
      }
    },
    {
      "id": "env-7",
      "go_test": "api.TestTelemetryEnvelopeInvalidRequest422/non-array_items_(object)",
      "body": "{\"items\":{}}",
      "expected": {
        "status": 422,
        "code": "invalid_request",
        "message": "malformed request body: json: cannot unmarshal object into Go struct field telemetryEnvelope.items of type []json.RawMessage",
        "details": {}
      }
    },
    {
      "id": "env-8",
      "go_test": "api.TestTelemetryEnvelopeInvalidRequest422/trailing_content",
      "body": "{\"items\":[]}{}",
      "expected": {
        "status": 422,
        "code": "invalid_request",
        "message": "request body has trailing content",
        "details": {}
      }
    },
    {
      "id": "env-9",
      "go_test": "api.TestTelemetryEnvelopeInvalidRequest422/501_items",
      "body": "{\"items\":[null x 501]}",
      "expected": {
        "status": 422,
        "code": "invalid_request",
        "message": "items has 501 entries, exceeding the 500-entry limit",
        "details": {
          "count": 501,
          "limit": 500
        }
      }
    }
  ],
  "enums_exact": {
    "error_class": [
      "timeout",
      "connect_error",
      "provider_error",
      "other"
    ],
    "endpoint_used": [
      "direct",
      "vertex",
      "bedrock",
      "azure",
      "openrouter"
    ],
    "endpoint_used_default": "direct",
    "max_items": 500
  },
  "details_rule": "details jsonb = {status} plus each of latency_ms, tokens_in, tokens_out, finish_reason, error_class, check_pass that was present on the item (endpoint_used is a column, not in details). Keys serialize sorted.",
  "notes": [
    "501 items body is the JSON encoding of {\"items\":[null,null,...501 times]} (Go marshals 501 nil maps as null).",
    "Envelope decoding does NOT reject unknown top-level fields (no DisallowUnknownFields) but does reject trailing content.",
    "Item decoding is lenient too: unknown item fields are ignored; case-insensitive key match applies (Go)."
  ]
}
