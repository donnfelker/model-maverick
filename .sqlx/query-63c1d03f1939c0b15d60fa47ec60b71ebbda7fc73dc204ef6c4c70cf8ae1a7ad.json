  "db_name": "PostgreSQL",
  "query": "update batches\n         set lease_owner = $2,\n             lease_expires_at = now() + make_interval(secs => $3),\n             heartbeat_at = now(),\n             attempt = attempt + 1,\n             updated_at = now()\n         where id = $1\n         returning id, kind, batch_window, status, lease_owner, lease_expires_at,\n                   heartbeat_at, attempt, completed_at, created_at, updated_at",
