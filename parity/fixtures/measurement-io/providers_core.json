  "retry_loop": [
    {
      "go_test": "providers.TestRetrySucceedsFirstTry",
      "fn_results": [
        "nil"
      ],
      "calls": 1,
      "result": "nil"
    },
    {
      "go_test": "providers.TestRetryRecoversFromRetryableErrors",
      "fn_results": [
        "wrap(test,429)",
        "wrap(test,429)",
        "nil"
      ],
      "calls": 3,
      "result": "nil"
    },
    {
      "go_test": "providers.TestRetryExhaustsAndStampsAttempts",
      "fn_results": [
        "wrap(test,503) always"
      ],
      "calls": 3,
      "result": {
        "kind": "provider_error",
        "attempts": 3
      }
    },
    {
      "go_test": "providers.TestRetryStopsOnNonRetryable",
      "fn_results": [
        "wrap(test,400)"
      ],
      "calls": 1,
      "result": {
        "kind": "invalid_request",
        "attempts": 1
      }
    },
    {
      "go_test": "providers.TestRetryStopsOnTimeoutKind",
      "fn_results": [
        "wrap(test,0,DeadlineExceeded)"
      ],
      "calls": 1,
      "result": {
        "kind": "timeout"
      }
    },
    {
      "go_test": "providers.TestRetryHonorsContextMidBackoff",
      "ctx_timeout_ms": 20,
      "policy": {
        "base_ms": 500,
        "max_ms": 1000
      },
      "fn_results": [
        "wrap(test,429) always"
      ],
      "calls": 1,
      "result": {
        "kind": "timeout",
        "provider": "test",
        "attempts": 1,
        "unwraps_to": "context.DeadlineExceeded",
        "message": "test: timeout after 1 attempt(s): context deadline exceeded"
      }
    }
  ]
}
