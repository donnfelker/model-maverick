{
  "about": "json_schema grader. Error strings are exact Go output except '{SPEC_SCHEMA_URL}' / '{TASK_SCHEMA_URL}', which Go renders as 'file://<process cwd>/spec.schema.json#' (cwd-dependent, see QUIRK in behavior doc). Text after the 'jsonschema validation failed with' marker is santhosh-tekuri/jsonschema v6 library wording; parity requirement is the prefix up to and including '<kind> spec: ' plus the pass/fail decision, and 'contains' checks named in go_test_expect.",
  "go_tests": {
    "jsonschema.TestKind": {
      "expect_kind": "json_schema"
    },
    "jsonschema.TestValidateSpecAccepts": {
      "spec_raw": "{\n\t\t\"schema\": {\"type\": \"object\", \"required\": [\"a\"]},\n\t\t\"checks\": [\n\t\t\t{\"path\": \"$.a\", \"equals\": null},\n\t\t\t{\"path\": \"$.b[2].c\", \"regex\": \"\\\\d+\"},\n\t\t\t{\"path\": \"$.d\", \"numeric\": 1.5, \"tolerance\": 0.1}\n\t\t]\n\t}",
      "expect": "valid"
    },
    "jsonschema.TestParsePath": {
      "path": "$.items[10].name",
      "segments": [
        {
          "key": "items",
          "index": -1
        },
        {
          "key": "",
          "index": 10
        },
        {
          "key": "name",
          "index": -1
        }
      ],
      "reject": "$[x]"
    },
    "jsonschema.TestValueEqual": [
      {
        "a": {
          "json_number": "12500"
        },
        "b": {
          "float64": 12500
        },
        "equal": true
      },
      {
        "a": {
          "string": "12500"
        },
        "b": {
          "float64": 12500
        },
        "equal": false
      },
      {
        "a": {
          "object": {
            "a": [
              {
                "json_number": "1"
              },
              "x"
            ]
          }
        },
        "b": {
          "object": {
            "a": [
              {
                "float64": 1
              },
              "x"
            ]
          }
        },
        "equal": true
      }
    ]
  },
  "validate_spec_rejects": [
    {
      "id": "not json",
      "go_test": "jsonschema.TestValidateSpecRejects/not_json",
      "spec_raw": "{",
      "expect_error_contains": "json_schema spec",
      "go_error": "json_schema spec: unexpected EOF"
    },
    {
      "id": "missing schema",
      "go_test": "jsonschema.TestValidateSpecRejects/missing_schema",
      "spec_raw": "{\"checks\": [{\"path\": \"$.a\", \"equals\": 1}]}",
      "expect_error_contains": "json_schema spec",
      "go_error": "json_schema spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '': missing property 'schema'"
    },
    {
      "id": "unknown field",
      "go_test": "jsonschema.TestValidateSpecRejects/unknown_field",
      "spec_raw": "{\"schema\": {}, \"extra\": true}",
      "expect_error_contains": "json_schema spec",
      "go_error": "json_schema spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '': additional properties 'extra' not allowed"
    },
    {
      "id": "schema wrong type",
      "go_test": "jsonschema.TestValidateSpecRejects/schema_wrong_type",
      "spec_raw": "{\"schema\": \"object\"}",
      "expect_error_contains": "json_schema spec",
      "go_error": "json_schema spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/schema': got string, want boolean or object"
    },
    {
      "id": "empty checks",
      "go_test": "jsonschema.TestValidateSpecRejects/empty_checks",
      "spec_raw": "{\"schema\": {}, \"checks\": []}",
      "expect_error_contains": "json_schema spec",
      "go_error": "json_schema spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/checks': minItems: got 0, want 1"
    },
    {
      "id": "check without kind",
      "go_test": "jsonschema.TestValidateSpecRejects/check_without_kind",
      "spec_raw": "{\"schema\": {}, \"checks\": [{\"path\": \"$.a\"}]}",
      "expect_error_contains": "json_schema spec",
      "go_error": "json_schema spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/checks/0': 'oneOf' failed, none matched\n  - at '/checks/0': missing property 'equals'\n  - at '/checks/0': missing property 'regex'\n  - at '/checks/0': missing property 'numeric'"
    },
    {
      "id": "check with two kinds",
      "go_test": "jsonschema.TestValidateSpecRejects/check_with_two_kinds",
      "spec_raw": "{\"schema\": {}, \"checks\": [{\"path\": \"$.a\", \"equals\": 1, \"numeric\": 1}]}",
      "expect_error_contains": "json_schema spec",
      "go_error": "json_schema spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/checks/0': 'oneOf' failed, subschemas 0, 2 matched"
    },
    {
      "id": "tolerance without numeric",
      "go_test": "jsonschema.TestValidateSpecRejects/tolerance_without_numeric",
      "spec_raw": "{\"schema\": {}, \"checks\": [{\"path\": \"$.a\", \"equals\": 1, \"tolerance\": 0.1}]}",
      "expect_error_contains": "json_schema spec",
      "go_error": "json_schema spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/checks/0': properties 'numeric' required, if 'tolerance' exists"
    },
    {
      "id": "negative tolerance",
      "go_test": "jsonschema.TestValidateSpecRejects/negative_tolerance",
      "spec_raw": "{\"schema\": {}, \"checks\": [{\"path\": \"$.a\", \"numeric\": 1, \"tolerance\": -0.1}]}",
      "expect_error_contains": "json_schema spec",
      "go_error": "json_schema spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/checks/0/tolerance': minimum: got -0.1, want 0"
    },
    {
      "id": "path without dollar",
      "go_test": "jsonschema.TestValidateSpecRejects/path_without_dollar",
      "spec_raw": "{\"schema\": {}, \"checks\": [{\"path\": \"a.b\", \"equals\": 1}]}",
      "expect_error_contains": "json_schema spec",
      "go_error": "json_schema spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/checks/0/path': 'a.b' does not match pattern '^\\\\$'"
    },
    {
      "id": "bad path segment",
      "go_test": "jsonschema.TestValidateSpecRejects/bad_path_segment",
      "spec_raw": "{\"schema\": {}, \"checks\": [{\"path\": \"$..a\", \"equals\": 1}]}",
      "expect_error_contains": "empty segment",
      "go_error": "json_schema spec: checks[0]: path \"$..a\" has an empty segment"
    },
    {
      "id": "bad check regex",
      "go_test": "jsonschema.TestValidateSpecRejects/bad_check_regex",
      "spec_raw": "{\"schema\": {}, \"checks\": [{\"path\": \"$.a\", \"regex\": \"(\"}]}",
      "expect_error_contains": "checks[0]",
      "go_error": "json_schema spec: checks[0]: error parsing regexp: missing closing ): `\\A(?:()\\z`"
    },
    {
      "id": "uncompilable embedded schema",
      "go_test": "jsonschema.TestValidateSpecRejects/uncompilable_embedded_schema",
      "spec_raw": "{\"schema\": {\"type\": \"nope\"}}",
      "expect_error_contains": "embedded schema",
      "go_error": "json_schema spec: embedded schema: \"{TASK_SCHEMA_URL}\" is not valid against metaschema: jsonschema validation failed with 'https://json-schema.org/draft/2020-12/schema#'\n- at '': 'allOf' failed\n  - at '/type': 'anyOf' failed\n    - at '/type': value must be one of 'array', 'boolean', 'integer', 'null', 'number', 'object', 'string'\n    - at '/type': got string, want array"
    },
    {
      "id": "unterminated index (probe)",
      "go_error": "json_schema spec: checks[0]: path \"$.a[1\" has an unterminated index",
      "valid": false
    },
    {
      "id": "negative index (probe)",
      "go_error": "json_schema spec: checks[0]: path \"$.a[-1]\" has a bad array index \"-1\"",
      "valid": false
    },
    {
      "id": "unexpected char (probe)",
      "go_error": "json_schema spec: checks[0]: path \"$a\": unexpected 'a'",
      "valid": false
    },
    {
      "id": "boolean schema true (probe)",
      "go_error": null,
      "valid": true
    },
    {
      "id": "remote ref (probe)",
      "go_error": "json_schema spec: embedded schema: failing loading \"https://example.com/x.json\": invalid file url: https://example.com/x.json",
      "valid": false
    }
  ],
  "extract_json": [
    {
      "output": "```json\n{\"a\":1}\n```",
      "method": "fenced",
      "extracted": true,
      "doc": {
        "a": 1
      },
      "go_test": "jsonschema.TestExtractJSON"
    },
    {
      "output": "```\n[1,2]\n```",
      "method": "fenced",
      "extracted": true,
      "doc": [
        1,
        2
      ],
      "go_test": "jsonschema.TestExtractJSON"
    },
    {
      "output": "```\n42\n```",
      "method": "fenced",
      "extracted": true,
      "doc": 42,
      "go_test": "jsonschema.TestExtractJSON"
    },
    {
      "output": "```\n{\"a\":1} extra\n```",
      "method": "bare",
      "extracted": true,
      "doc": {
        "a": 1
      },
      "go_test": "jsonschema.TestExtractJSON"
    },
    {
      "output": "the result: {\"a\": 1} done",
      "method": "bare",
      "extracted": true,
      "doc": {
        "a": 1
      },
      "go_test": "jsonschema.TestExtractJSON"
    },
    {
      "output": "list [1, 2, 3] end",
      "method": "bare",
      "extracted": true,
      "doc": [
        1,
        2,
        3
      ],
      "go_test": "jsonschema.TestExtractJSON"
    },
    {
      "output": "set {not json} then {\"a\":1}",
      "method": "bare",
      "extracted": true,
      "doc": {
        "a": 1
      },
      "go_test": "jsonschema.TestExtractJSON"
    },
    {
      "output": "the answer is 42",
      "method": "",
      "extracted": false,
      "doc": null,
      "go_test": "jsonschema.TestExtractJSON"
    },
    {
      "output": "no structured data here",
      "method": "",
      "extracted": false,
      "doc": null,
      "go_test": "jsonschema.TestExtractJSON"
    },
    {
      "output": "  ```json\n{\"a\":2}\n  ```",
      "method": "fenced",
      "extracted": true,
      "doc": {
        "a": 2
      },
      "probe": true
    },
    {
      "output": "```json\n\n```\n{\"b\":1}",
      "method": "bare",
      "extracted": true,
      "doc": {
        "b": 1
      },
      "probe": true
    },
    {
      "output": "```\n{\"a\":1}",
      "method": "bare",
      "extracted": true,
      "doc": {
        "a": 1
      },
      "probe": true
    },
    {
      "output": "```\n\"str\"\n```",
      "method": "fenced",
      "extracted": true,
      "doc": "str",
      "probe": true
    },
    {
      "output": "```\nnull\n```",
      "method": "fenced",
      "extracted": true,
      "doc": null,
      "probe": true
    },
    {
      "output": "{\"a\":1}{\"b\":2}",
      "method": "bare",
      "extracted": true,
      "doc": {
        "a": 1
      },
      "probe": true
    },
    {
      "output": "[1,2",
      "method": "",
      "extracted": false,
      "doc": null,
      "probe": true
    },
    {
      "output": "{\"a\":1e400}",
      "method": "bare",
      "extracted": true,
      "doc": {
        "a": {
          "json_number": "1e400"
        }
      },
      "probe": true,
      "note": "number kept as the literal json.Number '1e400'; numeric comparisons on it fail (Float64 overflows)"
    },
    {
      "output": "{\"a\":\"\\ud800\"}",
      "method": "bare",
      "extracted": true,
      "doc": {
        "a": "�"
      },
      "probe": true,
      "note": "lone surrogate escape decodes to U+FFFD"
    },
    {
      "output": "```js\n{\"a\":1}\n```\n```\n{\"b\":2}\n```",
      "method": "fenced",
      "extracted": true,
      "doc": {
        "a": 1
      },
      "probe": true
    },
    {
      "output": "{\"a\":1,\"a\":2}",
      "method": "bare",
      "extracted": true,
      "doc": {
        "a": 2
      },
      "probe": true
    }
  ],
