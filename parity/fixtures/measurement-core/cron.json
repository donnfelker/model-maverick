{
  "fires_on": {
    "cases": [
      {
        "expected": true,
        "expr": "0 4 * * 0",
        "night": "2030-06-02"
      },
      {
        "expected": false,
        "expr": "0 4 * * 0",
        "night": "2030-06-03"
      },
      {
        "expected": true,
        "expr": "50 2 * * *",
        "night": "2030-06-03"
      },
      {
        "expected": true,
        "expr": "0 0 15 * *",
        "night": "2030-05-15"
      },
      {
        "expected": false,
        "expr": "0 0 15 * *",
        "night": "2030-05-14"
      },
      {
        "expected": true,
        "expr": "59 23 * * 0",
        "night": "2030-06-02"
      },
      {
        "expected": true,
        "expr": "0 0 * * 1",
        "night": "2030-06-03"
      }
    ],
    "go_test": "jobs.TestCronFiresOn",
    "invalid_expression_error": "cron \"not a cron\": want 5 fields, got 3"
  },
  "iso_week": {
    "cases": [
      {
        "day": "2031-03-09",
        "expected": "2031-W10"
      },
      {
        "day": "2031-01-05",
        "expected": "2031-W01"
      },
      {
        "day": "2028-01-02",
        "expected": "2027-W52"
      },
      {
        "day": "2026-12-31",
        "expected": "2026-W53"
      },
      {
        "day": "2027-01-01",
        "expected": "2026-W53"
      },
      {
        "day": "2032-07-04",
        "expected": "2032-W27"
      }
    ],
    "format": "%04d-W%02d of the ISO 8601 (year, week)",
    "go_test": "jobs.TestIsoWeek"
  },
  "next": {
    "cases": [
      {
        "expected": "2026-07-06T03:00:00Z",
        "expr": "0 3 * * *",
        "from": "2026-07-06T02:00:00Z"
      },
      {
        "expected": "2026-07-07T03:00:00Z",
        "expr": "0 3 * * *",
        "from": "2026-07-06T03:00:00Z"
      },
      {
        "expected": "2026-07-06T02:50:00Z",
        "expr": "50 2 * * *",
        "from": "2026-07-06T02:49:00Z"
      },
      {
        "expected": "2026-07-07T06:10:00Z",
        "expr": "10 6 * * *",
        "from": "2026-07-06T06:10:00Z"
      },
      {
        "expected": "2026-07-06T10:15:00Z",
        "expr": "*/15 * * * *",
        "from": "2026-07-06T10:07:00Z"
      },
      {
        "expected": "2026-07-06T11:00:00Z",
        "expr": "0 * * * *",
        "from": "2026-07-06T10:00:00Z"
      },
      {
        "expected": "2026-07-12T04:00:00Z",
        "expr": "0 4 * * 0",
        "from": "2026-07-06T10:00:00Z"
      },
      {
        "expected": "2026-07-12T04:00:00Z",
        "expr": "0 4 * * 7",
        "from": "2026-07-06T10:00:00Z"
      },
      {
        "expected": "2026-08-15T05:30:00Z",
        "expr": "30 5 15 * *",
        "from": "2026-07-16T00:00:00Z"
      },
      {
        "expected": "2028-02-29T00:00:00Z",
        "expr": "0 0 29 2 *",
        "from": "2026-07-06T00:00:00Z"
      },
      {
        "expected": "2026-07-06T03:00:00Z",
        "expr": "0 3 * * *",
        "from": "2026-07-06T02:59:59.000000999Z"
      },
      {
        "expected": "2031-07-06T00:01:00Z",
        "expr": "0 0 31 2 *",
        "from": "2026-07-06T00:00:00Z"
      },
      {
        "expected": "2026-07-13T03:00:00Z",
        "expr": "0 3 1 * 1",
        "from": "2026-07-06T04:00:00Z"
      },
      {
        "expected": "2026-07-06T10:05:00Z",
        "expr": "5/20 * * * *",
        "from": "2026-07-06T10:00:00Z"
      },
      {
        "expected": "2026-07-13T12:00:00Z",
        "expr": "0 12 * * 1-5",
        "from": "2026-07-10T12:00:00Z"
      }
    ],
    "go_test": "jobs.TestCronNext",
    "note": "Next returns the first matching minute strictly after `from` (from truncated to the minute, plus 1 minute). Impossible schedules return from+1min+5 years (the search horizon), not an error."
  },
  "parse_accept": {
    "cases": [
      {
        "expr": "50 2 * * *",
        "ok": true
      },
      {
        "expr": "0 3 * * *",
        "ok": true
      },
      {
        "expr": "0 4 * * 0",
        "ok": true
      },
      {
        "expr": "0 * * * *",
        "ok": true
      },
      {
        "expr": "0 6 * * *",
        "ok": true
      },
      {
        "expr": "10 6 * * *",
        "ok": true
      },
      {
        "expr": "0 5 * * *",
        "ok": true
      },
      {
        "expr": "*/15 * * * *",
        "ok": true
      },
      {
        "expr": "0 3 1-15 * 1,3",
        "ok": true
      }
    ],
    "go_test": "jobs.TestParseCronAcceptsConfigDefaults"
  },
  "parse_reject": {
    "cases": [
      {
        "error": "cron \"\": want 5 fields, got 0",
        "expr": "",
        "ok": false
      },
      {
        "error": "cron \"* * *\": want 5 fields, got 3",
        "expr": "* * *",
        "ok": false
      },
      {
        "error": "cron \"61 0 * * *\" field 1: value out of range 0-59: \"61\"",
        "expr": "61 0 * * *",
        "ok": false
      },
      {
        "error": "cron \"0 24 * * *\" field 2: value out of range 0-23: \"24\"",
        "expr": "0 24 * * *",
        "ok": false
      },
      {
        "error": "cron \"0 0 0 * *\" field 3: value out of range 1-31: \"0\"",
        "expr": "0 0 0 * *",
        "ok": false
      },
      {
        "error": "cron \"0 0 * 13 *\" field 4: value out of range 1-12: \"13\"",
        "expr": "0 0 * 13 *",
        "ok": false
      },
      {
        "error": "cron \"0 0 * * 8\" field 5: value out of range 0-7: \"8\"",
        "expr": "0 0 * * 8",
        "ok": false
      },
      {
        "error": "cron \"a * * * *\" field 1: invalid value \"a\"",
        "expr": "a * * * *",
        "ok": false
      },
      {
        "error": "cron \"*/0 * * * *\" field 1: invalid step \"*/0\"",
        "expr": "*/0 * * * *",
        "ok": false
      },
      {
        "error": "cron \"5-1 * * * *\" field 1: value out of range 0-59: \"5-1\"",
        "expr": "5-1 * * * *",
        "ok": false
      },
      {
        "error": "cron \"99 99 * * *\" field 1: value out of range 0-59: \"99\"",
        "expr": "99 99 * * *",
        "ok": false
      },
      {
        "error": "cron \"* * * *\": want 5 fields, got 4",
        "expr": "* * * *",
        "ok": false
      }
    ],
    "go_test": "jobs.TestParseCronRejectsInvalid, jobs.TestNewClientRejectsBadNightlyCron, jobs.TestNewClientRejectsBadHistoryPruneCron"
  }
}
