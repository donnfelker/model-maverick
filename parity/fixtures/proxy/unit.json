  "rewrite_model": [
    {
      "input_body": "{\"model\":\"maverick/auto\",\"stream\":true,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"temperature\":0.7}",
      "model": "gpt-5.5-mini",
      "name": "TestRewriteModel",
      "normalizer": "none",
      "output_body": "{\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"model\":\"gpt-5.5-mini\",\"stream\":true,\"temperature\":0.7}",
      "id": "rewrite_model-0"
    },
    {
      "input_body": "{\"model\":\"maverick/auto\",\"output_config\":{\"effort\":\"high\",\"custom_ratio\":0.50},\"messages\":[]}",
      "model": "claude-y",
      "name": "TestEffortNormalization_LeavesEverythingElseAlone/messages:_effort_high_untouched",
      "normalizer": "messages",
      "output_body": "{\"messages\":[],\"model\":\"claude-y\",\"output_config\":{\"effort\":\"high\",\"custom_ratio\":0.50}}",
      "id": "rewrite_model-1"
    },
    {
      "input_body": "{\"model\":\"maverick/auto\",\"messages\":[]}",
      "model": "claude-y",
      "name": "TestEffortNormalization_LeavesEverythingElseAlone/messages:_absent_output_config_stays_absent",
      "normalizer": "messages",
      "output_body": "{\"messages\":[],\"model\":\"claude-y\"}",
      "id": "rewrite_model-2"
    },
    {
      "input_body": "{\"model\":\"maverick/auto\",\"reasoning_effort\":\"medium\",\"messages\":[]}",
      "model": "gpt-a",
      "name": "TestEffortNormalization_LeavesEverythingElseAlone/chat:_reasoning_effort_medium_untouched",
      "normalizer": "chat",
      "output_body": "{\"messages\":[],\"model\":\"gpt-a\",\"reasoning_effort\":\"medium\"}",
      "id": "rewrite_model-3"
    },
    {
      "input_body": "{\"model\":\"maverick/auto\",\"messages\":[]}",
      "model": "gpt-a",
      "name": "TestEffortNormalization_LeavesEverythingElseAlone/chat:_absent_reasoning_effort_stays_absent",
      "normalizer": "chat",
      "output_body": "{\"messages\":[],\"model\":\"gpt-a\"}",
      "id": "rewrite_model-4"
    },
    {
      "input_body": "{\"model\":\"maverick/auto\",\"output_config\":{\"effort\":\"xhigh\",\"custom_ratio\":0.50, \"b\" : 1},\"temperature\":1e2}",
      "model": "claude-y",
      "name": "messages xhigh -> max (output_config keys re-sorted, compacted)",
