{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmaverick.dev/graders/judge_rubric/spec.schema.json",
  "title": "judge_rubric grader spec (version 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["rubric"],
  "properties": {
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension", "criterion"],
        "additionalProperties": false,
        "properties": {
          "dimension": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "criterion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "judge_prompt": { "type": "string", "minLength": 1 },
    "reference": { "type": "string", "minLength": 1 }
  }
}
