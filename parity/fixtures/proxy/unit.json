      "output_body": "{\"model\":\"gpt-a\",\"reasoning_effort\":\"high\"}",
      "id": "rewrite_model-6"
    },
    {
      "input_body": "{\"model\":\"maverick/auto\",\"output_config\":{\"effort\":\"xhigh\"}}",
      "model": "gpt-a",
      "name": "EXTRA chat normalizer ignores output_config",
      "normalizer": "chat",
      "output_body": "{\"model\":\"gpt-a\",\"output_config\":{\"effort\":\"xhigh\"}}",
      "id": "rewrite_model-7"
    },
    {
