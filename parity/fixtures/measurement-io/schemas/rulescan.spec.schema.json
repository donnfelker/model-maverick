{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelmaverick.dev/graders/rule_scan/spec.schema.json",
  "title": "rule_scan grader spec (version 1)",
  "type": "object",
  "required": ["rules"],
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "must_include": { "type": "string", "minLength": 1 },
        "must_not_include": { "type": "string", "minLength": 1 },
        "regex": { "type": "boolean" },
        "case_insensitive": { "type": "boolean" },
        "max_length_chars": { "type": "integer", "minimum": 1 },
        "max_length_words": { "type": "integer", "minimum": 1 },
        "line_count": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "min": { "type": "integer", "minimum": 0 },
                "max": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        },
        "language": {
          "enum": ["en", "es", "fr", "de", "it", "pt", "nl", "ru", "zh", "ja", "ko", "ar", "he", "el", "hi", "th"]
        },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "critical": { "type": "boolean" }
      },
      "oneOf": [
        { "required": ["must_include"] },
        { "required": ["must_not_include"] },
        { "required": ["max_length_chars"] },
        { "required": ["max_length_words"] },
        { "required": ["line_count"] },
        { "required": ["language"] }
      ],
      "dependentSchemas": {
        "regex": {
          "anyOf": [
            { "required": ["must_include"] },
            { "required": ["must_not_include"] }
          ]
        },
        "case_insensitive": {
          "anyOf": [
            { "required": ["must_include"] },
            { "required": ["must_not_include"] }
          ]
        }
      }
    }
  }
}
