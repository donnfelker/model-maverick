  "db_name": "PostgreSQL",
  "query": "select o.id, o.recommendation_id, o.model_used, o.outcome, o.escalated_to,\n                  o.details as \"details: _\", o.created_at, o.endpoint_used\n           from outcomes o\n           join recommendations r on r.id = o.recommendation_id\n           where r.tenant_id = $1\n             and ($2::text = '' or o.recommendation_id = $2)\n             and ($3::text = '' or o.outcome = $3)\n             and ($4::timestamptz is null or o.created_at >= $4)\n             and ($5::text = '' or o.id < $5)\n           order by o.id desc\n           limit $6",
