{
  "about": "runner: prompt assembly, cost, status mapping, pacing, runs rows. Times are Go time.Duration; nanos given.",
  "assemble": [
    {
      "go_test": "runner.TestAssembleGoldenBasic",
      "task": {
        "id": "task_assemble_001",
        "prompt": "Extract every defined term from the contract and return them as JSON.",
        "attachments_json": "[]",
        "temperature": 0,
        "max_tokens": 1024
      },
      "column": {
        "id": "col_assemble_001",
        "provider": "anthropic",
        "model_id": "claude-opus-4-8",
        "endpoint": "direct",
        "settings_json": "{}"
      },
      "expect": {
        "model": "claude-opus-4-8",
        "system": "",
        "prompt_exact": "Extract every defined term from the contract and return them as JSON.",
        "prompt_golden_file": "testdata/internal/runner/testdata/assemble_basic.golden",
        "temperature": 0,
        "max_tokens": 1024,
        "settings": null
      }
    },
    {
      "go_test": "runner.TestAssembleGoldenAttachments",
      "task": {
        "prompt": "Summarize the agreement, citing the attached documents.",
        "attachments_json": "[\n\t\t{\"name\": \"contract.txt\", \"content\": \"THIS AGREEMENT is made between Acme Corp and Beta LLC.\\nSection 1. Term: 24 months.\"},\n\t\t{\"name\": \"amendment.txt\", \"content\": \"Section 1 is amended to read: Term: 36 months.\"}\n\t]"
      },
      "expect": {
        "prompt_exact": "Summarize the agreement, citing the attached documents.\n\n--- attachment: contract.txt ---\nTHIS AGREEMENT is made between Acme Corp and Beta LLC.\nSection 1. Term: 24 months.\n\n--- attachment: amendment.txt ---\nSection 1 is amended to read: Term: 36 months.",
        "prompt_golden_file": "testdata/internal/runner/testdata/assemble_attachments.golden"
      }
    },
    {
      "go_test": "runner.TestAssembleByteIdenticalAcrossColumnsAndCalls",
      "task": {
        "prompt": "Answer from the notes.",
        "attachments_json": "[{\"name\": \"notes.txt\", \"content\": \"alpha\\nbeta\"}]"
      },
      "columns": [
        {
          "model_id": "claude-opus-4-8",
          "provider": "anthropic",
          "settings_json": "{\"thinking\": true}"
        },
        {
          "model_id": "gpt-5.5",
          "provider": "openai",
          "settings_json": "{}"
        }
      ],
      "expect": {
        "prompt_exact_all_calls": "Answer from the notes.\n\n--- attachment: notes.txt ---\nalpha\nbeta",
        "models_differ": true
      }
    },
    {
      "go_test": "runner.TestAssembleColumnSettings",
      "column_settings_json": "{\"thinking\": true, \"thinking_budget\": 2048}",
      "expect_settings": {
        "thinking": true,
        "thinking_budget": 2048.0
      },
      "note": "settings decode as generic JSON: numbers become float64"
    },
    {
      "go_test": "runner.TestAssembleMalformedInputs",
      "cases": [
        {
          "attachments_json": "[{\"name\": broken",
          "settings_json": "{}",
          "error": "task task_assemble_001: parsing attachments: invalid character 'b' looking for beginning of value"
        },
        {
          "attachments_json": "[]",
          "settings_json": "{broken",
          "error": "column col_assemble_001: parsing settings: invalid character 'b' looking for beginning of object key string"
        }
      ]
    },
    {
