  "fixture_results": [
    {
      "file": "bad_spec_rule_without_kind.yaml",
      "description": "a rule carrying only weight and critical has no kind and is rejected",
      "spec_json": {
        "rules": [
          {
            "critical": true,
            "weight": 2
          }
        ]
      },
      "output": "irrelevant",
      "validate_error": "rule_scan spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/rules/0': 'oneOf' failed, none matched\n  - at '/rules/0': missing property 'must_include'\n  - at '/rules/0': missing property 'must_not_include'\n  - at '/rules/0': missing property 'max_length_chars'\n  - at '/rules/0': missing property 'max_length_words'\n  - at '/rules/0': missing property 'line_count'\n  - at '/rules/0': missing property 'language'",
      "failure_counter": 0
    },
