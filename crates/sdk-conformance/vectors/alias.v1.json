{
  "vector_set": "alias",
  "version": "v1",
  "source": "master plan §3.5 'The alias grammar'; sdk-v0 plan §2.1; reference Part 6 §5 (Go ParseAlias, rows go-*: parity/fixtures/proxy/unit.json#parse_alias); D14 (rows d14-*); crates/maverick-core/src/alias.rs. Hand-checked.",
  "rule": [
    "If the model string ends with exactly ?settings=caller, remove that suffix once; settings is then caller, else apply (D14).",
    "The rest must start with exactly maverick/ (case sensitive), else the kind is not_maverick_alias.",
    "After the prefix: with a ':', split at the FIRST ':' into pool and mode word; an empty pool or mode word is malformed_alias. Without a ':', there is no pool (null) and the whole rest is the mode word.",
    "The mode word is exact: auto is the engine mode balanced, quality is quality, cost is cost. Anything else is malformed_alias. Nothing is trimmed."
  ],
  "actions": {
    "alias": {
      "sdk": "Route: POST /v1/recommend with mode and pool (pool omitted when null); apply each entry's settings unless settings is caller.",
      "proxy": "Route, as the SDK does."
    },
    "not_maverick_alias": {
      "sdk": "Pass the original model string through unchanged; MM is not contacted (master plan §3.5).",
      "proxy": "400 invalid_model_alias."
    },
    "malformed_alias": {
      "sdk": "Pass the original model string through unchanged; MM is not contacted (sdk-v0 plan §2.1: anything else passes through untouched).",
      "proxy": "400 invalid_model_alias."
    }
  },
  "how_to_run": "For each case, parse model. kind alias must match pool, mode, and settings exactly; the other kinds carry no fields.",
  "cases": [
    {
      "id": "go-0",
      "model": "maverick/auto",
      "expect": {
        "kind": "alias",
        "pool": null,
        "mode": "balanced",
        "settings": "apply"
      }
    },
    {
      "id": "go-1",
      "model": "maverick/quality",
      "expect": {
