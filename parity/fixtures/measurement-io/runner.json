  "batch_integration": {
    "go_test": "runner.TestBatchPersistsTwoTasksTwoColumnsThreeRepeats",
    "columns": [
      {
        "provider": "anthropic",
        "model_id": "claude-runner-a",
        "pricing_json": "{\"input_per_mtok\": 3.00, \"output_per_mtok\": 15.00, \"currency\": \"USD\", \"as_of\": \"2026-07-01\", \"source\": \"list\"}"
      },
      {
        "provider": "openai",
        "model_id": "gpt-runner-b",
        "pricing_json": "{\"input_per_mtok\": 2.50, \"output_per_mtok\": 10.00, \"currency\": \"USD\", \"as_of\": \"2026-07-01\", \"source\": \"list\"}"
      }
    ],
    "fake_fixtures": [
      {
        "model": "claude-runner-a",
        "prompt": "Runner integration prompt one.",
        "output": "a1",
        "tokens_in": 120,
        "tokens_out": 18,
        "latency_ms": 5
      },
      {
        "model": "claude-runner-a",
        "prompt": "Runner integration prompt two.",
        "output": "a2",
        "tokens_in": 200,
        "tokens_out": 40,
        "latency_ms": 5
      },
      {
        "model": "gpt-runner-b",
        "prompt": "Runner integration prompt one.",
        "output": "b1",
        "tokens_in": 118,
        "tokens_out": 17,
        "latency_ms": 5
      },
      {
        "model": "gpt-runner-b",
        "prompt": "Runner integration prompt two.",
        "output": "b2",
        "tokens_in": 210,
        "tokens_out": 33,
        "latency_ms": 5
      }
    ],
    "config": {
      "repeats": 3,
      "timeout_s": 30
    },
    "batch_repeats": 0,
    "expect": {
      "total": 12,
      "ok": 12,
      "per_pair_cost": {
        "one×a": 0.00063,
        "two×a": 0.0012,
        "one×b": 0.000465,
        "two×b": 0.000855
      },
      "repeat_indexes_per_pair": [
        0,
        1,
        2
      ],
      "latency_ms_min": 5,
      "summary_cost_equals_sum_of_rows_within": 1e-09,
      "matrix_version": "= corpus version string",
      "batch_id": "generated bat_<ULID>"
    }
  },
