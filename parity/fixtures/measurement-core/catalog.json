  "parse_pricing": {
    "cases": [
      {
        "expected": {
          "pricing": {
            "as_of": "2026-07-01",
            "currency": "USD",
            "input_per_mtok": 3,
            "output_per_mtok": 15,
            "source": "list"
          }
        },
        "raw": "{\"input_per_mtok\": 3.00, \"output_per_mtok\": 15.00, \"currency\": \"USD\", \"as_of\": \"2026-07-01\", \"source\": \"list\"}"
      },
      {
        "expected": {
          "pricing": {
            "as_of": "",
            "currency": "",
            "input_per_mtok": 0,
            "output_per_mtok": 0,
            "source": ""
          }
        },
        "raw": "{}"
      },
      {
        "expected": {
          "pricing": {
            "as_of": "",
            "currency": "",
            "input_per_mtok": 0,
            "output_per_mtok": 0,
            "source": ""
          }
        },
        "raw": null
      },
      {
        "expected": {
          "error": "parsing pricing snapshot: json: cannot unmarshal string into Go struct field Pricing.input_per_mtok of type float64"
        },
        "raw": "{\"input_per_mtok\": \"three\"}"
      },
      {
        "expected": {
          "error": "pricing snapshot has a negative price"
        },
        "raw": "{\"input_per_mtok\": -1}"
      },
      {
        "expected": {
          "pricing": {
            "as_of": "",
            "currency": "",
            "input_per_mtok": 1,
            "output_per_mtok": 0,
            "source": ""
          }
        },
        "raw": "{\"input_per_mtok\": 1, \"extra_field\": true}"
      },
      {
        "expected": {
          "pricing": {
            "as_of": "",
            "currency": "",
            "input_per_mtok": 0,
            "output_per_mtok": 0,
            "source": ""
          }
        },
        "raw": "null"
      }
    ],
    "go_test": "catalog.TestParsePricing"
  },
