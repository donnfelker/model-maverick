      "in": "already clean",
      "out": "already clean",
      "go_test": "golden.TestNormalize"
    },
    {
      "in": "?!.",
      "out": "",
      "go_test": "golden.TestNormalize"
    },
    {
      "in": "Paris. .",
      "out": "paris.",
      "probe": true
    },
