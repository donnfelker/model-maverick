{
  "vector_set": "alias",
  "version": "v2",
  "source": "Owner-approved production-proxy plan §3; D45 and D14. Hand-checked. Replaces alias.v1.json.",
  "rule": [
    "Only the exact maverick/ prefix routes. Split the remainder at the first colon into route and optional variant.",
    "Route auto selects the default pool (null). Every other nonempty route names a pool, including slash and space characters. Nothing is trimmed.",
    "Variants are exactly quality, balanced, cost. The default is quality. Empty routes, empty or unknown variants, and query suffixes are malformed_alias.",
    "Every other input is a direct model. Split at the first slash into author and slug; no slash means author null. Provider validation belongs to the caller.",
    "Settings are a separate request option, X-Maverick-Settings: caller, never a model suffix."
  ],
  "actions": {
    "route": "Ask the engine for pool and mode; apply recommended settings unless the separate settings option is caller.",
    "direct": "No engine call or telemetry. Native author prefixes are stripped; foreign authors are refused on a native surface. OpenRouter passes the original model unchanged.",
    "malformed_alias": "Reject the malformed route."
  },
  "cases": [
    {"id":"auto","model":"maverick/auto","expect":{"kind":"route","pool":null,"mode":"quality"}},
    {"id":"auto-quality","model":"maverick/auto:quality","expect":{"kind":"route","pool":null,"mode":"quality"}},
    {"id":"auto-balanced","model":"maverick/auto:balanced","expect":{"kind":"route","pool":null,"mode":"balanced"}},
    {"id":"auto-cost","model":"maverick/auto:cost","expect":{"kind":"route","pool":null,"mode":"cost"}},
    {"id":"pool","model":"maverick/prod-pool","expect":{"kind":"route","pool":"prod-pool","mode":"quality"}},
    {"id":"pool-quality","model":"maverick/prod-pool:quality","expect":{"kind":"route","pool":"prod-pool","mode":"quality"}},
    {"id":"pool-balanced","model":"maverick/prod-pool:balanced","expect":{"kind":"route","pool":"prod-pool","mode":"balanced"}},
    {"id":"pool-cost","model":"maverick/prod-pool:cost","expect":{"kind":"route","pool":"prod-pool","mode":"cost"}},
    {"id":"native-author","model":"anthropic/claude-opus-5-5","expect":{"kind":"direct","author":"anthropic","slug":"claude-opus-5-5"}},
    {"id":"bare","model":"claude-opus-5-5","expect":{"kind":"direct","author":null,"slug":"claude-opus-5-5"}},
    {"id":"quality-pool","model":"maverick/quality","expect":{"kind":"route","pool":"quality","mode":"quality"}},
    {"id":"cost-pool","model":"maverick/cost","expect":{"kind":"route","pool":"cost","mode":"quality"}},
    {"id":"balanced-pool","model":"maverick/balanced","expect":{"kind":"route","pool":"balanced","mode":"quality"}},
    {"id":"unknown-route","model":"maverick/fast","expect":{"kind":"route","pool":"fast","mode":"quality"}},
    {"id":"author-pool","model":"maverick/openai","expect":{"kind":"route","pool":"openai","mode":"quality"}},
    {"id":"slash-pool","model":"maverick/pool/x:quality","expect":{"kind":"route","pool":"pool/x","mode":"quality"}},
    {"id":"slash-no-variant","model":"maverick/pool/x","expect":{"kind":"route","pool":"pool/x","mode":"quality"}},
    {"id":"space-pool","model":"maverick/p p:cost","expect":{"kind":"route","pool":"p p","mode":"cost"}},
    {"id":"leading-space-pool","model":"maverick/ auto","expect":{"kind":"route","pool":" auto","mode":"quality"}},
    {"id":"route-case","model":"maverick/AUTO","expect":{"kind":"route","pool":"AUTO","mode":"quality"}},
    {"id":"unicode-pool","model":"maverick/日本語:cost","expect":{"kind":"route","pool":"日本語","mode":"cost"}},
    {"id":"prefix-case","model":"Maverick/auto","expect":{"kind":"direct","author":"Maverick","slug":"auto"}},
    {"id":"bare-empty","model":"","expect":{"kind":"direct","author":null,"slug":""}},
    {"id":"bare-gpt","model":"gpt-4o","expect":{"kind":"direct","author":null,"slug":"gpt-4o"}},
    {"id":"bare-claude","model":"claude-sonnet-4-6","expect":{"kind":"direct","author":null,"slug":"claude-sonnet-4-6"}},
    {"id":"author-slashes","model":"openrouter/author/model:batch","expect":{"kind":"direct","author":"openrouter","slug":"author/model:batch"}},
    {"id":"direct-variant","model":"openai/gpt-6-astra:batch","expect":{"kind":"direct","author":"openai","slug":"gpt-6-astra:batch"}},
    {"id":"direct-query","model":"gpt-4o?settings=caller","expect":{"kind":"direct","author":null,"slug":"gpt-4o?settings=caller"}},
    {"id":"bare-prefix","model":"maverick/","expect":{"kind":"malformed_alias"}},
    {"id":"empty-route","model":"maverick/:quality","expect":{"kind":"malformed_alias"}},
    {"id":"empty-variant","model":"maverick/prod-pool:","expect":{"kind":"malformed_alias"}},
    {"id":"empty-both","model":"maverick/:","expect":{"kind":"malformed_alias"}},
    {"id":"empty-auto","model":"maverick/:auto","expect":{"kind":"malformed_alias"}},
    {"id":"double-colon","model":"maverick/prod:pool:auto","expect":{"kind":"malformed_alias"}},
    {"id":"auto-variant","model":"maverick/auto:auto","expect":{"kind":"malformed_alias"}},
    {"id":"pool-auto-variant","model":"maverick/prod-pool:auto","expect":{"kind":"malformed_alias"}},
    {"id":"unknown-variant","model":"maverick/prod-pool:fast","expect":{"kind":"malformed_alias"}},
    {"id":"variant-case","model":"maverick/auto:QUALITY","expect":{"kind":"malformed_alias"}},
    {"id":"variant-space","model":"maverick/auto: cost","expect":{"kind":"malformed_alias"}},
    {"id":"variant-trailing","model":"maverick/auto:cost ","expect":{"kind":"malformed_alias"}},
    {"id":"suffix-auto","model":"maverick/auto?settings=caller","expect":{"kind":"malformed_alias"}},
    {"id":"suffix-quality","model":"maverick/quality?settings=caller","expect":{"kind":"malformed_alias"}},
    {"id":"suffix-pool","model":"maverick/prod-pool:cost?settings=caller","expect":{"kind":"malformed_alias"}},
    {"id":"suffix-apply","model":"maverick/auto?settings=apply","expect":{"kind":"malformed_alias"}},
    {"id":"suffix-case","model":"maverick/auto?settings=CALLER","expect":{"kind":"malformed_alias"}},
    {"id":"suffix-twice","model":"maverick/auto?settings=caller?settings=caller","expect":{"kind":"malformed_alias"}},
    {"id":"suffix-no-route","model":"maverick/?settings=caller","expect":{"kind":"malformed_alias"}},
    {"id":"query-in-route","model":"maverick/p?settings=caller:balanced","expect":{"kind":"malformed_alias"}},
    {"id":"empty-author","model":"/model","expect":{"kind":"direct","author":"","slug":"model"}}
  ]
}
