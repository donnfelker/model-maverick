  "split_items": [
    {
      "in": "- Red\n2. green;  BLUE, \n\n",
      "out": [
        "red",
        "green",
        "blue"
      ],
      "go_test": "golden.TestSplitItems"
    },
    {
      "in": "* a\n** b\n• c",
      "out": [
        "a",
        "b",
        "c"
      ],
      "probe": true
    },
    {
      "in": "1) x\n10. y\n3.z",
      "out": [
        "x",
        "y",
        "3.z"
      ],
      "probe": true
    },
    {
      "in": "-a",
      "out": [
        "-a"
      ],
      "probe": true
    },
    {
      "in": "a,,b;;c",
      "out": [
        "a",
        "b",
        "c"
      ],
      "probe": true
    },
    {
      "in": "1.5, 2.5",
      "out": [
        "1.5",
        "2.5"
      ],
      "probe": true
    },
    {
      "in": "- ",
      "out": [
        "-"
      ],
      "probe": true
    },
    {
      "in": "red\r\nblue",
      "out": [
        "red",
        "blue"
      ],
      "probe": true
    }
  ],
  "fixture_results": [
    {
      "file": "bad_spec_two_modes.yaml",
      "description": "an answer declaring two modes is rejected at validation",
      "spec_json": {
        "answers": [
          {
            "regex": "paris",
            "value": "Paris"
          }
        ]
      },
      "output": "irrelevant",
      "validate_error": "golden_answer spec: jsonschema validation failed with '{SPEC_SCHEMA_URL}'\n- at '/answers/0': 'oneOf' failed, subschemas 0, 3 matched",
      "failure_counter": 0
    },
    {
      "file": "exact_miss.yaml",
      "description": "a wrong answer scores 0, not an error",
      "spec_json": {
        "answers": [
          {
            "value": "Paris"
          }
        ]
      },
      "output": "London",
      "dimensions": {
        "answer_correctness": 0
      },
      "detail": {
        "matched": false,
        "answer_index": -1,
        "answers": [
          {
            "index": 0,
            "mode": "value",
            "matched": false
          }
        ]
      },
      "detail_exact_bytes": "{\"matched\":false,\"answer_index\":-1,\"answers\":[{\"index\":0,\"mode\":\"value\",\"matched\":false}]}",
      "failure_counter": 0
    },
    {
